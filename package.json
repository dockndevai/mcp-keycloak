{
  "name": "@dockndevai/mcp-keycloak",
  "mcpName": "io.github.dockndevai/mcp-keycloak",
  "version": "0.1.2",
  "description": "Model Context Protocol server for Keycloak — multi-realm admin access with security modes and access-control flags.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dockndevai/mcp-keycloak.git"
  },
  "bugs": {
    "url": "https://github.com/dockndevai/mcp-keycloak/issues"
  },
  "homepage": "https://github.com/dockndevai/mcp-keycloak#readme",
  "bin": {
    "mcp-keycloak": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "keycloak",
    "iam",
    "llm",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
