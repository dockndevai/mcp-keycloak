{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dockndevai/mcp-keycloak",
  "description": "Keycloak admin for AI agents — realms, users, clients, roles; safe-by-default governance.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-keycloak",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dockndevai/mcp-keycloak",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KEYCLOAK_URL",
          "description": "Base URL of the Keycloak server (no trailing slash).",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "KEYCLOAK_CLIENT_ID",
          "description": "Client id used to authenticate (default admin-cli).",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "KEYCLOAK_CLIENT_SECRET",
          "description": "Service-account client secret (or use KEYCLOAK_USERNAME/PASSWORD).",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "KEYCLOAK_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
