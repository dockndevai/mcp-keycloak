# --- Connection -------------------------------------------------------------
# Base URL of your Keycloak server (no trailing slash).
KEYCLOAK_URL=https://keycloak.example.com
# Realm used to authenticate the admin credentials (usually "master").
KEYCLOAK_AUTH_REALM=master

# --- Credentials (pick ONE strategy) ----------------------------------------
# Strategy A: service account (recommended). Provide a confidential client with
# the realm-management roles it needs.
KEYCLOAK_CLIENT_ID=admin-cli
# KEYCLOAK_CLIENT_SECRET=your-client-secret

# Strategy B: admin username/password.
# KEYCLOAK_USERNAME=admin
# KEYCLOAK_PASSWORD=change-me

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
KEYCLOAK_MODE=read-only
# Comma-separated realm allowlist. Empty = every reachable realm.
KEYCLOAK_REALM_ALLOWLIST=
# Realms that can be read but never mutated. Default: master.
KEYCLOAK_PROTECTED_REALMS=master
# Destructive delete_* tools require this in addition to admin mode.
KEYCLOAK_ALLOW_DELETE=false
# Validate writes and log intent without sending them to Keycloak.
KEYCLOAK_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
KEYCLOAK_AUDIT_LOG=true
# Set to false ONLY for local self-signed certs. Disables TLS verification.
KEYCLOAK_TLS_REJECT_UNAUTHORIZED=true
